{
  "name": "swadistha-pos",
  "productName": "Swadistha POS",
  "version": "0.2.1",
  "private": true,
  "description": "Swadistha Cafe POS",
  "main": "main.js",
  "author": "Swadistha",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "preview": "python -m http.server 4173",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "26.0.0"
  },
  "build": {
    "appId": "com.swadistha.pos",
    "productName": "Swadistha POS",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swadistha POS"
    }
  }
}
